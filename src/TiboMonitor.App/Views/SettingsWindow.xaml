<Window x:Class="TiboMonitor.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tibo Monitor 设置"
        Width="560"
        Height="680"
        MinWidth="480"
        MinHeight="420"
        MaxWidth="720"
        MaxHeight="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F8FAFC"
        Loaded="SettingsWindow_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,24,26,16">
            <TextBlock Text="设置"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#0F172A" />
            <TextBlock Text="保存后立即应用；检查间隔将从保存时刻重新计时。"
                       Margin="0,6,0,20"
                       Foreground="#64748B" />

            <Border Padding="16"
                    Margin="0,0,0,18"
                    CornerRadius="6"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="监控账号" Foreground="#64748B" />
                    <TextBlock x:Name="AccountText" Grid.Column="1" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="数据来源" Foreground="#64748B" />
                    <TextBlock x:Name="SourceText" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="数据目录" Foreground="#64748B" />
                    <TextBlock x:Name="DataPathText"
                               Grid.Row="2"
                               Grid.Column="1"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <TextBlock Text="监控"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#0F172A" />
            <CheckBox x:Name="MonitoringEnabledCheckBox"
                      Margin="0,12,0,4"
                      Content="启用监控（关闭后停止网络检查）"
                      ToolTip="关闭后保留程序、托盘、已有未读和本地数据，但不再自动或手动检查新动态。" />
            <Grid Margin="0,12,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="检查间隔" VerticalAlignment="Center" />
                <TextBox x:Name="IntervalMinutesTextBox"
                         Grid.Column="1"
                         Padding="8,5"
                         HorizontalContentAlignment="Right" />
                <TextBlock Grid.Column="2"
                           Margin="10,0,0,0"
                           Text="分钟（5～1440）"
                           VerticalAlignment="Center"
                           Foreground="#64748B" />
            </Grid>

            <TextBlock Text="提醒内容"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#0F172A" />
            <StackPanel Margin="0,10,0,18">
                <CheckBox x:Name="NotifyOriginalsCheckBox"
                          Margin="0,5"
                          Content="提醒原创（Original）：该账号自己发布的普通帖子"
                          ToolTip="默认开启；不属于回复、引用或纯转发的普通原创帖子。" />
                <CheckBox x:Name="NotifyRepliesCheckBox"
                          Margin="0,5"
                          Content="提醒回复（Reply）：该账号回复别人的帖子"
                          ToolTip="例如该账号点击“回复”并发送的内容。" />
                <CheckBox x:Name="NotifyQuotesCheckBox"
                          Margin="0,5"
                          Content="提醒引用（Quote）：该账号引用帖子并附加文字"
                          ToolTip="引用别人的帖子，同时写下自己的评论。" />
                <CheckBox x:Name="NotifyRepostsCheckBox"
                          Margin="0,5"
                          Content="提醒纯转发（Repost）：该账号不加文字直接转发"
                          ToolTip="第三方公开源不一定能稳定识别所有纯转发。" />
            </StackPanel>

            <TextBlock Text="程序行为"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#0F172A" />
            <StackPanel Margin="0,10,0,18">
                <CheckBox x:Name="TopMostCheckBox"
                          Margin="0,5"
                          Content="提醒窗口始终置顶" />
                <CheckBox x:Name="AutoStartCheckBox"
                          Margin="0,5"
                          Content="Windows 登录后自动启动" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Button Content="打开数据目录" Click="OpenDataButton_Click" />
                <Button Content="打开日志目录" Click="OpenLogsButton_Click" />
            </StackPanel>

            <Border Padding="12"
                    CornerRadius="4"
                    Background="#FFF7ED"
                    BorderBrush="#FDBA74"
                    BorderThickness="1">
                <TextBlock Text="提示：首次运行历史提醒、数据源地址和重置 baseline 属于高级操作，不在此窗口开放，避免误操作。"
                           TextWrapping="Wrap"
                           Foreground="#9A3412" />
            </Border>
        </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Padding="18,10"
                BorderBrush="#CBD5E1"
                BorderThickness="0,1,0,0"
                Background="White">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Click="CancelButton_Click" />
                <Button Content="保存"
                        IsDefault="True"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="#2563EB"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
