<Window x:Class="TiboMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tibo 新动态"
        Width="620"
        Height="520"
        MinWidth="520"
        MinHeight="430"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="#FFF8F0"
        Closing="Window_Closing">
    <Border BorderBrush="#F59E0B" BorderThickness="4" CornerRadius="6" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="⚠  Tibo 发布了新消息"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#9A3412" />
                <TextBlock x:Name="AccountText"
                           Text="@thsottiaux"
                           Margin="0,8,0,0"
                           FontSize="16"
                           Foreground="#475569" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,18,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="UnreadText" Text="未读：0" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock x:Name="TimeText" Margin="0,5,0,0" Foreground="#64748B" />
                    <TextBlock x:Name="TypeText" Margin="0,3,0,0" Foreground="#64748B" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PreviousButton" Content="← 上一条" Click="PreviousButton_Click" />
                    <TextBlock x:Name="PositionText" VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold" />
                    <Button x:Name="NextButton" Content="下一条 →" Click="NextButton_Click" />
                </StackPanel>
            </Grid>

            <TextBox x:Name="BodyText"
                     Grid.Row="2"
                     Padding="16"
                     FontSize="17"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     Background="White"
                     BorderBrush="#FDBA74"
                     BorderThickness="1" />

            <TextBlock x:Name="StatusText"
                       Grid.Row="3"
                       Margin="0,12,0,4"
                       Foreground="#64748B"
                       Text="窗口关闭按钮只会隐藏；只有“我已读”会修改状态。" />

            <Grid Grid.Row="4" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="OpenPostButton"
                        Content="在浏览器打开原文"
                        HorizontalAlignment="Left"
                        Click="OpenPostButton_Click" />
                <Button x:Name="MarkReadButton"
                        Grid.Column="1"
                        Content="我已读"
                        FontWeight="Bold"
                        Background="#EA580C"
                        Foreground="White"
                        Click="MarkReadButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
